{
  "expo": {
    "name": "lifepilot",
    "slug": "lifepilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lifepilot-icon.png",
    "scheme": "lifepilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/lifepilot-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1110",
        "foregroundImage": "./assets/images/lifepilot-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ajaydmja.lifepilot"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1110",
          "image": "./assets/images/lifepilot-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      ["expo-notifications", { "defaultChannel": "vehicle-reminders", "color": "#5BE49B" }],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow LifePilot to take photos of your vehicles.",
          "photosPermission": "Allow LifePilot to select photos for your vehicles.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98cbcf3b-29b3-48cf-a77a-1bcf99256da9"
      }
    }
  }
}
