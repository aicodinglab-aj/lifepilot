{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "preview" },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": { "EXPO_PUBLIC_APP_VARIANT": "production" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
